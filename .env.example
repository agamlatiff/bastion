# Application Environment (development, staging, production, test)
APP_ENV=development
APP_PORT=8080

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5433
DB_USER=bastion
DB_PASSWORD=bastion_secret
DB_NAME=bastion_db
DB_SSLMODE=disable
DATABASE_URL=postgres://bastion:bastion_secret@localhost:5433/bastion_db?sslmode=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Kafka / Redpanda Event Broker
KAFKA_BROKERS=localhost:19092

# Security & Cryptography Secrets
JWT_SECRET=super_secret_bastion_key_change_in_production_12345
JWT_EXPIRY_HOURS=24

# 32-byte key (string 32 karakter) for AES-256 field-level data encryption
DATA_ENCRYPTION_KEY=01234567890123456789012345678901

# Network & Security Headers
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
TRUSTED_PROXIES=127.0.0.1,::1
